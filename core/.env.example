# Local development configuration for Sofia's Assistant.
#
# Copy this file to `.env` (already git-ignored) and adjust as needed.
# Only non-secret configuration belongs here. The Sofias Memory API key is
# never read from this file: store it via
#   uv run python -m sofias_assistant.secrets set integrations/sofias-memory/api-key

SOFIAS_ASSISTANT_MEMORY_BASE_URL=https://pefil-sofias-memory.q8cqqr.easypanel.host
SOFIAS_ASSISTANT_MEMORY_TIMEOUT_SECONDS=15
SOFIAS_ASSISTANT_MEMORY_RECALL_LIMIT=10

# Opt-in gate for tests/integration/memory/test_memory_live_smoke.py.
# Set to 1 only when you intend to run that smoke against a real Sofias
# Memory instance; leave at 0 (or unset) for the default local test suite.
SOFIAS_ASSISTANT_RUN_MEMORY_INTEGRATION_TESTS=0
