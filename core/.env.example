# Local development configuration for Sofia's Assistant.
#
# Copy this file to `.env` (already git-ignored) and adjust as needed.
# Only non-secret configuration belongs here.

# ---------------------------------------------------------------------------
# Production `sofia-core` host (Runtime Configuration Contract v1)
#
# This file is never loaded implicitly. `sofia-core` (and
# `python -m sofias_assistant.host`) only read it when you pass it
# explicitly:
#
#   uv run sofia-core --env-file .env
#
# Without `--env-file`, configure entirely through the real process
# environment instead; process environment always overrides this file.
# ---------------------------------------------------------------------------

# Core
SOFIA_CORE_HOST=127.0.0.1
SOFIA_CORE_PORT=8989
# Blank resolves to the existing platform default (Windows: %LOCALAPPDATA%\SofiasAssistant).
SOFIA_DATA_DIR=

# Canonical/default AI provider bootstrap. This is a *bootstrap* model, not
# the model used for every AI operation (Amendment 0003 SS9). The API key is
# never read from this file by any adapter: it is bridged into
# SecretService as `providers/{LLM_PROVIDER}/api-key`. Leave LLM_API_KEY
# blank here and set it in your real process environment instead, or store
# it durably via:
#   uv run python -m sofias_assistant.secrets set providers/openai/api-key
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=

# Sofias Memory bootstrap. The API key is bridged into SecretService as
# `integrations/sofias-memory/api-key`; it is never read from this file by
# any adapter. Leave SOFIAS_MEMORY_API_KEY blank here and set it in your
# real process environment instead, or store it durably via:
#   uv run python -m sofias_assistant.secrets set integrations/sofias-memory/api-key
SOFIAS_MEMORY_ENABLED=false
SOFIAS_MEMORY_BASE_URL=
SOFIAS_MEMORY_API_KEY=

# ---------------------------------------------------------------------------
# Legacy local development configuration (unrelated to the sofia-core host)
#
# Used only by `sofias_assistant.config.loader.load_runtime_config` and the
# opt-in Sofias Memory live smoke test below.
# ---------------------------------------------------------------------------

SOFIAS_ASSISTANT_MEMORY_BASE_URL=https://pefil-sofias-memory.q8cqqr.easypanel.host
SOFIAS_ASSISTANT_MEMORY_TIMEOUT_SECONDS=15
SOFIAS_ASSISTANT_MEMORY_RECALL_LIMIT=10

# Opt-in gate for tests/integration/memory/test_memory_live_smoke.py.
# Set to 1 only when you intend to run that smoke against a real Sofias
# Memory instance; leave at 0 (or unset) for the default local test suite.
SOFIAS_ASSISTANT_RUN_MEMORY_INTEGRATION_TESTS=0
